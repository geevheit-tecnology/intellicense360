# ==============================================================================
# Geevheit Intelligence 360 — Configurações de Ambiente de Produção
# Copie este arquivo para .env.production antes do deploy:
# cp .env.production.example .env.production
# ==============================================================================

# Identificação da Instalação / Empresa
ENVIRONMENT=production
NODE_ENV=production
TENANT_DEFAULT_ID=empresa-principal-uuid

# Portas de Serviço
WEB_PORT=80
API_PORT=8080

# Banco de Dados PostgreSQL 16
POSTGRES_DB=geevheit_intelligence_prod
POSTGRES_USER=geevheit_admin
POSTGRES_PASSWORD=alterar_para_senha_segura_de_producao_32_chars!
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgres://geevheit_admin:alterar_para_senha_segura_de_producao_32_chars!@postgres:5432/geevheit_intelligence_prod?sslmode=disable

# Cache & Event Bus Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=alterar_para_senha_redis_forte_32_chars!
REDIS_URL=redis://:alterar_para_senha_redis_forte_32_chars!@redis:6379/0

# Segurança, Tokens & Sessões (JWT)
# Gere uma chave com: openssl rand -base64 48
JWT_SECRET=substituir_por_chave_criptografica_forte_minimo_64_caracteres_aleatorios
SESSION_TIMEOUT_HOURS=24
CORS_ALLOWED_ORIGINS=https://app.suatransportadora.com.br,https://gestao.suatransportadora.com.br

# Monitoramento de Sinais & IA Autônoma (SignalScanner 24/7)
SCANNER_INTERVAL_SECONDS=60
AUTO_DISPATCH_ENABLED=true
AUTO_ALERT_SMS_WHATSAPP=false

# Políticas de Backup do Banco
BACKUP_SCHEDULE=0 3 * * *
BACKUP_RETENTION_DAYS=30

