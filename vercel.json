{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "/api/index.go"
    },
    {
      "source": "/src/:match*",
      "destination": "/apps/mission-control/src/:match*"
    },
    {
      "source": "/(.*)",
      "destination": "/apps/mission-control/index.html"
    }
  ]
}
